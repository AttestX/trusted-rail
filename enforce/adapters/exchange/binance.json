    {
      "when": {
        "method": "POST",
        "path": "/api/v3/order"
      },
      "refuse": "a pair not quoted in USDT or USDC (or USD, on Binance.US): its amount is not in dollars"
    },
    {
      "when": {
        "method": "DELETE",
        "path": "/api/v3/order"
      },
      "operation": "order.cancel",
      "resource": "order",
      "parameters": {
        "order": {
          "first": [
            "/input/orderId",
