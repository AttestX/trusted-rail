{
  "id": "binance",
  "category": "exchange",
  "summary": "Binance spot (and Binance.US). An order is typed with its value in its quote asset: a market order's quoteOrderQty, or quantity times price for a limit, limit-maker, stop-loss-limit or take-profit-limit order. Only USDT and USDC pairs are typed (and USD pairs on Binance.US). An order whose value is not stated, pegged and trailing orders, several orders in one request, routed orders, replacing or amending an order, withdrawals and every other /sapi write are refused. Fields are read from the query and the body together; one given twice is refused. Cancels are typed; reads, test orders and user data streams pass.",
  "input": "form",
  "hosts": [
    "api.binance.com",
    "api1.binance.com",
    "api2.binance.com",
    "api3.binance.com",
    "api4.binance.com",
    "api-gcp.binance.com",
    "api.binance.us"
  ],
  "unmatched": "refuse",
  "actions": [
    {
      "when": {
        "method": "POST",
        "path": "/api/v3/order/test"
      },
      "pass": true
    },
    {
      "when": {
        "method": "POST",
        "path": "/api/v3/order",
        "fields": [
          {
            "at": "/input/symbol",
            "matches": "[A-Z0-9]{2,16}USDT"
          },
          {
            "at": "/input/quantity",
            "is": [
              null
            ]
          }
        ]
      },
      "require": [
        {
          "at": "/input/type",
          "in": [
            "MARKET"
          ],
          "case": "any",
          "reason": "an order by quoteOrderQty must be a market order"
        },
        {
          "at": "/input/side",
          "in": [
            "BUY",
            "SELL"
          ],
          "case": "any",
          "reason": "an order that is neither a buy nor a sell"
        },
        {
          "at": "/input/pegPriceType",
          "in": [
            null
          ],
          "reason": "a pegged order's price is not stated"
        },
        {
          "at": "/input/trailingDelta",
          "in": [
            null
          ],
          "reason": "a trailing order's price is not stated"
        }
      ],
      "operation": "order.place",
      "resource": "symbol",
      "parameters": {
        "symbol": {
          "at": "/input/symbol",
          "as": "lower"
        },
        "side": {
          "at": "/input/side",
          "as": "lower"
        },
        "order_type": {
          "at": "/input/type",
          "as": "lower"
        },
        "amount_micro": {
          "at": "/input/quoteOrderQty",
          "as": "micro",
          "decimals": 0
        },
        "currency": {
          "const": "usdt"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "binance"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/api/v3/order",
        "fields": [
          {
            "at": "/input/symbol",
            "matches": "[A-Z0-9]{2,16}USDT"
          },
          {
            "at": "/input/type",
            "is": [
