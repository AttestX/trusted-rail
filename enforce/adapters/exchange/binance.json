        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "binance"
        }
      }
    },
    {
      "when": {
        "path": "/api/v3/order/cancelReplace"
      },
      "refuse": "replacing an order changes it out of sight: cancel it and place a new one"
    },
    {
      "when": {
