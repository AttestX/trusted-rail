  "actions": [
    {
      "when": {
        "method": "POST",
        "path": "/info"
      },
      "pass": true
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "order"
            ]
          },
          {
            "at": "/input/action/orders/1",
            "is": [
              null
            ]
          },
          {
            "at": "/input/action/orders/0/b",
            "is": [
              true
            ]
          }
        ]
      },
      "require": [
        {
          "at": "/input/action/grouping",
          "in": [
            "na"
          ],
          "reason": "an order grouped with take-profit or stop-loss orders is several orders: send each on its own"
        },
        {
          "at": "/input/action/builder",
          "in": [
            null
          ],
          "reason": "a builder fee pays a third party"
        },
        {
          "at": "/input/action/orders/0/t/trigger/isMarket",
          "in": [
            null,
            false
          ],
          "reason": "a market trigger order's price is not stated"
        }
      ],
      "operation": "order.place",
      "resource": "symbol",
      "parameters": {
        "symbol": {
          "at": "/input/action/orders/0/a",
          "as": "lookup",
          "table": "perps"
        },
        "side": {
          "const": "buy"
        },
        "order_type": {
          "const": "limit"
        },
        "amount_micro": {
          "at": "/input/action/orders/0/p",
          "as": "micro",
          "decimals": 0,
          "times": "/input/action/orders/0/s"
        },
        "quantity_micro": {
          "at": "/input/action/orders/0/s",
          "as": "micro",
          "decimals": 0
        },
        "limit_price_micro": {
          "at": "/input/action/orders/0/p",
          "as": "micro",
          "decimals": 0
        },
        "currency": {
          "const": "usdc"
        },
        "account": {
          "at": "/input/vaultAddress",
          "default": "main",
          "as": "lower"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "hyperliquid"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "order"
            ]
          },
          {
            "at": "/input/action/orders/1",
            "is": [
              null
            ]
          },
          {
            "at": "/input/action/orders/0/b",
            "is": [
              false
            ]
          }
        ]
      },
      "require": [
        {
          "at": "/input/action/grouping",
          "in": [
            "na"
          ],
          "reason": "an order grouped with take-profit or stop-loss orders is several orders: send each on its own"
        },
        {
          "at": "/input/action/builder",
          "in": [
            null
          ],
          "reason": "a builder fee pays a third party"
        },
        {
          "at": "/input/action/orders/0/t/trigger/isMarket",
          "in": [
            null,
            false
          ],
          "reason": "a market trigger order's price is not stated"
        }
      ],
      "operation": "order.place",
      "resource": "symbol",
      "parameters": {
        "symbol": {
          "at": "/input/action/orders/0/a",
          "as": "lookup",
          "table": "perps"
        },
        "side": {
          "const": "sell"
        },
        "order_type": {
          "const": "limit"
        },
        "amount_micro": {
          "at": "/input/action/orders/0/p",
          "as": "micro",
          "decimals": 0,
          "times": "/input/action/orders/0/s"
        },
        "quantity_micro": {
          "at": "/input/action/orders/0/s",
          "as": "micro",
          "decimals": 0
        },
        "limit_price_micro": {
          "at": "/input/action/orders/0/p",
          "as": "micro",
          "decimals": 0
        },
        "currency": {
          "const": "usdc"
        },
        "account": {
          "at": "/input/vaultAddress",
          "default": "main",
          "as": "lower"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "hyperliquid"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "order"
            ]
          }
        ]
      },
      "refuse": "several orders in one request: send each on its own, so each is decided"
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "cancel"
            ]
          }
        ]
      },
      "operation": "order.cancel",
      "resource": "order",
      "parameters": {
        "order": {
          "at": "/input/action/cancels/0/o"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "hyperliquid"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "cancelByCloid"
            ]
          }
        ]
      },
      "operation": "order.cancel",
      "resource": "order",
      "parameters": {
        "order": {
          "at": "/input/action/cancels/0/cloid",
          "as": "lower"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "hyperliquid"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "scheduleCancel"
            ]
          }
        ]
      },
      "operation": "order.cancel",
      "resource": "order",
      "parameters": {
        "order": {
          "const": "all"
        },
        "venue": {
          "at": "/request/host"
        },
        "rail": {
          "const": "hyperliquid"
        }
      }
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "modify",
              "batchModify"
            ]
          }
        ]
      },
      "refuse": "modifying an order changes it out of sight: cancel it and place a new one"
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "twapOrder"
            ]
          }
        ]
      },
      "refuse": "a TWAP order's price is not stated"
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "updateLeverage",
              "updateIsolatedMargin",
              "topUpIsolatedOnlyMargin"
            ]
          }
        ]
      },
      "refuse": "leverage and margin are the owner's to change"
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "usdSend",
              "spotSend",
              "withdraw3",
              "sendAsset",
              "usdClassTransfer",
              "vaultTransfer",
              "subAccountTransfer",
              "subAccountSpotTransfer",
              "cDeposit",
              "cWithdraw",
              "tokenDelegate"
            ]
          }
        ]
      },
      "refuse": "moving funds out of the trading account is not typed"
    },
    {
      "when": {
        "method": "POST",
        "path": "/exchange",
        "fields": [
          {
            "at": "/input/action/type",
            "is": [
              "approveAgent",
              "approveBuilderFee",
              "setReferrer",
              "createSubAccount",
              "convertToMultiSigUser",
              "evmUserModify",
              "createVault",
              "vaultModify",
              "vaultDistribute"
            ]
          }
        ]
      },
      "refuse": "account control (agents, builder fees, sub-accounts, multi-sig) is the owner's"
    }
  ]
}
